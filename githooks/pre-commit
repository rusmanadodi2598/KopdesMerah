#!/bin/sh
# Pre-commit hook KopdesMerah: blokir commit bila gitleaks menemukan
# secret/API key di staged changes. Mengandalkan exit code gitleaks
# (1 = leak ditemukan), bukan parsing output.
set -u

GITLEAKS_BIN="${GITLEAKS_BIN:-$HOME/workspace/tools/bin/gitleaks}"

if [ ! -x "$GITLEAKS_BIN" ]; then
  echo "peringatan: gitleaks tidak ditemukan di $GITLEAKS_BIN - pemeriksaan secret dilewati" >&2
  echo "instal gitleaks atau set GITLEAKS_BIN ke lokasinya" >&2
  exit 0
fi

"$GITLEAKS_BIN" protect --staged --verbose --redact --config .gitleaks.toml
